# CHUCHU BOT frontend environment template.
# Copy this file to .env.local for local dev, or set the same variable
# in your host's dashboard (Cloudflare Pages / Vercel / Netlify).
#
# The URL of the DEPLOYED backend (not localhost).
# Leave empty to use same-origin (works locally with the Vite dev proxy).
VITE_SERVER_URL=https://your-backend-name.onrender.com
